# Placeholders only. Copy to .env and fill in. Never commit .env.

# ---- Supabase (required) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use a dedicated key for MCP if you can (so you can revoke it alone).
SUPABASE_KEY=put-your-key-here

# ---- Descope (required) ----
DESCOPE_CONFIG_URL=https://api.descope.com/v1/apps/agentic/YOUR-PROJECT-ID/YOUR-MCP-SERVER-ID/.well-known/openid-configuration
# Public base URL of this server, WITHOUT /mcp. Set to your https domain in production.
BASE_URL=http://localhost:8000
# Scope every tool call must carry (add it to your Descope MCP server scopes)
MCP_REQUIRED_SCOPE=data:read

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- Data ----
# site_config keys the AI may read. Leave empty to share none.
PUBLIC_SITE_CONFIG_KEYS=company_info,services,faq
TIMEZONE=Asia/Kolkata
CACHE_SECONDS=60

# ---- Optional tools (all off by default) ----
ENABLE_ATTENDANCE_COUNTS=false
ENABLE_CERTIFICATE_VERIFY=false
# Debug tool that shows the caller's own claims. Keep false in production.
ENABLE_WHOAMI=false
